+
+type Score={mae:number;rmse:number;train_seconds:number;inference_ms_per_row:number;model_bytes:number};
+type ModelKey='random_forest'|'hist_gradient_boosting'|'baseline';
+type Report={version:string;samples:number;train_samples:number;test_samples:number;train_start:number;train_end:number;test_start:number;test_end:number;created_at:number;scores:Record<ModelKey,Score>;insight:string};
+type Forecast={origin:number;target_end:number;generated_at:number;version:string;predictions:Record<ModelKey,number>;actual:number|null;outcome:string};
+type State={status:string;error:string|null;eligible_examples:number;minimum_examples:number;valid_minutes:number;excluded_minutes:number;report:Report|null;forecasts:Forecast[];prospective:{samples:number;scores:Record<ModelKey,Score>|null}};
+const names:Record<ModelKey,string>={random_forest:'Random Forest',hist_gradient_boosting:'Histogram Gradient Boosting',baseline:'Repeat previous minute'};
+const keys=Object.keys(names) as ModelKey[];
+const num=new Intl.NumberFormat(undefined,{maximumFractionDigits:0});
+const date=(v:number)=>new Date(v*1000).toLocaleString();
+
+export default memo(function ForecastComparison(){
+ const [data,setData]=useState<State|null>(null),[error,setError]=useState('');
+ useEffect(()=>{let active=true;let timer:ReturnType<typeof setTimeout>;let controller:AbortController;
+  const poll=async()=>{controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),4000);try{const response=await fetch('/api/forecast',{signal:controller.signal});if(!response.ok)throw Error('Forecast service unavailable');const result=await response.json() as State;if(active){setData(result);setError('')}}catch{if(active)setError('Forecast service temporarily unavailable. Routing observations continue.')}finally{clearTimeout(timeout);if(active)timer=setTimeout(poll,5000)}};
+  void poll();return()=>{active=false;controller?.abort();clearTimeout(timer)};
+ },[]);
+ const report=data?.report,latest=data?.forecasts[0];
+ return <section className="panel forecast-panel" id="forecast-insights" aria-label="Routing forecast model comparison">
+  <div className="section-heading"><div><h2>Routing forecast comparison</h2><p>Two models, one target: observed UPDATE count in the next aligned minute</p></div><span className="badge">GLOBAL · {data?.status.toUpperCase()??'LOADING'}</span></div>
+  <p className="forecast-note">Random Forest and Histogram Gradient Boosting use the same inputs and target, compared with a repeat-previous-minute baseline. Uses all observed RIS traffic; dashboard filters do not apply. Forecasts describe this collector stream, not the entire Internet.</p>
+  {(error||data?.error)&&<div className="notice" role="status">{error||data?.error}</div>}
+  {!report&&<div className="forecast-warmup"><strong>{data?`${data.eligible_examples} / ${data.minimum_examples} eligible training windows`:'Connecting to forecast history…'}</strong><p>{data?.status==='training'?'Training both models in a separate worker…':'Collecting genuine history before reporting model performance. A fresh start needs about 3 hours 6 minutes of continuous valid observations.'}</p>{data&&<><progress aria-label="Training history collected" max={data.minimum_examples} value={Math.min(data.eligible_examples,data.minimum_examples)}/><p>{data.valid_minutes} complete minutes · {data.excluded_minutes} incomplete minutes excluded. Upstream outages and startup partial minutes are excluded; connected quiet minutes can be zero.</p></>}</div>}
+  {report&&<><div className="forecast-summary"><strong>{report.insight}</strong><p>{report.train_samples} training windows · {report.test_samples} later holdout windows · one-minute embargo · fixed settings · no shuffled split.</p><p>Holdout: {date(report.test_start)} – {date(report.test_end)} (local). Errors are UPDATE counts per 60-second window; lower is better. Latency is measured batch inference time per row.</p>{data?.status==='training'&&<p>Refreshing models; showing the last completed evaluation.</p>}</div>
+   <div className="forecast-table-scroll"><table className="forecast-table"><thead><tr><th>Model</th><th>Holdout MAE</th><th>Holdout RMSE</th><th>Train time</th><th>Inference / row</th><th>Model size</th></tr></thead><tbody>{keys.map(key=>{const score=report.scores[key];return <tr key={key}><th scope="row">{names[key]}</th><td>{num.format(score.mae)}</td><td>{num.format(score.rmse)}</td><td>{key==='baseline'?'—':`${score.train_seconds.toFixed(2)} s`}</td><td>{key==='baseline'?'—':`${score.inference_ms_per_row.toFixed(3)} ms`}</td><td>{key==='baseline'?'—':`${(score.model_bytes/1024).toFixed(1)} KiB`}</td></tr>})}</tbody></table></div>
+   <p className="forecast-note">Evaluation recorded {date(report.created_at)}. Live models are then refit on all {report.samples} available past windows. A single holdout cannot establish reliability across routing regimes. <a href="/api/forecast/report" target="_blank" rel="noreferrer">Open reproducible evaluation JSON</a></p>
+  </>}
+  {latest&&<div className="forecast-live"><strong>{latest.target_end>Date.now()/1000?'Current forecast':'Most recent forecast'} · {date(latest.origin)} – {new Date(latest.target_end*1000).toLocaleTimeString()}</strong><p>Generated {date(latest.generated_at)} · forecast version {latest.version}. {latest.outcome==='pending'?'Actual count pending target completion.':latest.outcome==='observed'?`Observed: ${num.format(latest.actual!)} UPDATEs.`:'Target minute excluded because capture was incomplete.'}</p><div className="forecast-values">{keys.map(key=><span key={key}><small>{names[key]}</small><b>{num.format(latest.predictions[key])}</b><small>UPDATEs / minute</small></span>)}</div>{Math.abs(latest.predictions.random_forest-latest.predictions.hist_gradient_boosting)>0&&<p>Model disagreement: {num.format(Math.abs(latest.predictions.random_forest-latest.predictions.hist_gradient_boosting))} UPDATEs. This is not a confidence interval.</p>}</div>}
+  {data?.prospective.scores&&<p className="forecast-note">Prospective MAE over {data.prospective.samples} completed forecasts from the current model version: {keys.map(key=>`${names[key]} ${num.format(data.prospective.scores![key].mae)}`).join(' · ')}. These forecasts were stored before their target minutes completed.</p>}
+ </section>
+});
